# Server-only values. Add these in Vercel Project Settings → Environment Variables.
# Never add NEXT_PUBLIC_ prefixes or expose any of these values in browser code.

# Razorpay (use test keys first, then live keys after the test payment succeeds).
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Supabase project (server-only service role key, never the anon/publishable key).
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Random 32+ byte secret used to sign short-lived download cookies.
# Generate with: openssl rand -hex 32
EBOOK_DOWNLOAD_SECRET=

# Private Supabase Storage location. Create this bucket as private.
EBOOK_STORAGE_BUCKET=ebooks
EBOOK_STORAGE_PATH=ai-agent-automation-income-blueprint.pdf
EBOOK_FILE_NAME=AI-Agent-Automation-Income-Blueprint.pdf

# Product settings. 19900 paise = ₹199.
# Keep the price shown on index.html in sync with this value.
EBOOK_PRICE_PAISE=19900
EBOOK_CURRENCY=INR

# Download access lifetime in days.
EBOOK_ACCESS_DAYS=7
EBOOK_PENDING_DAYS=7

# Public site origin used for same-origin checks.
SITE_URL=https://www.sujathaprofessionalservices.com

# Optional extra allowed origins, comma-separated (for preview deployments).
# ALLOWED_ORIGINS=https://sujathaprofessionalservices.com,https://sujatha-professional-services.vercel.app

# Local-only credentials for scripts/apply-supabase-migration.mjs.
# Do NOT add these to Vercel runtime environment variables.
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_PROJECT_REF=

# Optional local source path for scripts/upload-ebook.mjs.
# EBOOK_SOURCE_PDF=C:\Users\Dell\Documents\SPS-Private-Assets\ai-agent-automation-income-blueprint.pdf
